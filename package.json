{
  "name": "paintdotjs",
  "version": "2.6.1-dev.0",
  "description": "An open source general-purpose raster graphics editor program.",
  "main": "js/platform/desktop/main.js",
  "desktopName": "paintdotjs.desktop",
  "license": "MIT",
  "homepage": "https://github.com/DanielChydz/paintdotjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielChydz/paintdotjs.git"
  },
  "paintdotjs": {
    "assetSet": "paintjs-open-v1"
  },
  "scripts": {
    "lint": "eslint js src scripts webpack.config.js",
    "test": "node --test tests/*.test.js tests/*.test.cjs",
    "test:coverage": "node scripts/test_coverage.js",
    "test:coverage:check": "npm run test:coverage && c8 report --check-coverage --lines 100 --branches 100 --functions 100 --statements 100",
    "test:effects": "node --test tests/effects.test.js",
    "pretest:firefox": "npm run pages",
    "test:firefox": "xvfb-run -a node scripts/test_firefox.js",
    "test:desktop": "node --test tests/desktop.test.cjs",
    "check-assets": "node ./scripts/check_assets.js",
    "check-version-info": "node ./scripts/check_version_info.js",
    "headers": "node ./scripts/sync_source_headers.js",
    "check-headers": "node ./scripts/sync_source_headers.js --check",
    "preweb": "npm run lint && npm run check-assets && npm run check-version-info && npm run check-headers",
    "web": "webpack --config webpack.config.js",
    "pages": "npm run web && node ./scripts/build_pages.js && node ./scripts/generate_pwa.js",
    "preweb-watch": "npm run lint && npm run check-assets && npm run check-version-info && npm run check-headers",
    "web-watch": "webpack --config webpack.config.js --watch",
    "preapp": "npm run desktop:build",
    "app": "electron .",
    "predesktop:build": "npm run lint && npm run check-assets && npm run check-version-info && npm run check-headers",
    "desktop:build": "webpack --config webpack.config.js && node scripts/prepare_desktop.js",
    "dist": "npm run desktop:build && electron-builder",
    "dist:linux": "npm run desktop:build && electron-builder --linux AppImage",
    "dist:deb": "npm run desktop:build && electron-builder --linux deb --publish never",
    "dist:rpm": "npm run desktop:build && electron-builder --linux rpm --publish never",
    "dist:mac": "npm run desktop:build && electron-builder --mac dmg zip --universal",
    "install:local": "node ./scripts/install_local.js",
    "assets:manifest": "node scripts/generate_asset_manifest.js",
    "gen-imports": "node ./scripts/generate_imports.js",
    "pwa": "npm run pages",
    "prepublish": "npm run web",
    "test:package": "node scripts/test_packaged.js"
  },
  "keywords": [
    "paint",
    "paint.js",
    "paintdotjs",
    "paintjs",
    "paintdotnet",
    "paint.net",
    "paintnet"
  ],
  "author": {
    "name": "LabyStudio",
    "url": "https://github.com/LabyStudio"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "binaryen": "132.0.0",
    "c8": "^12.0.0",
    "clean-css": "5.3.3",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "terser": "^5.51.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "workbox-build": "^7.4.1"
  },
  "dependencies": {
    "@imagemagick/magick-wasm": "^0.0.44",
    "buffer": "^6.0.3",
    "custom-electron-titlebar": "^4.4.1",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "ms-nrbf-js": "^0.1.0",
    "yauzl": "^3.4.0"
  },
  "build": {
    "appId": "net.paintjs.desktop",
    "productName": "paint.js",
    "executableName": "paintdotjs",
    "artifactName": "paintdotjs-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "index.html",
      "package.json",
      "LICENSE.md",
      "NOTICE.md",
      "docs/image-encoders.md",
      {
        "from": "build/desktop",
        "to": ".",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      "desktop-resources/**/*",
      "build/web/**/*",
      "!node_modules/@imagemagick/magick-wasm/**/*",
      "!node_modules/ms-nrbf-js/**/*",
      "!node_modules/buffer/**/*",
      "!**/*.map",
      "!node_modules/fflate/**/*",
      "!node_modules/yauzl/**/*",
      "!node_modules/pend/**/*",
      "!node_modules/base64-js/**/*",
      "!node_modules/ieee754/**/*",
      "!node_modules/custom-electron-titlebar/**/*.mjs",
      "!node_modules/js-yaml/dist/**/*",
      "!node_modules/js-yaml/bin/**/*",
      "!node_modules/argparse/**/*"
    ],
    "extraResources": [
      {
        "from": "desktop-resources/asset-manifest.json",
        "to": "desktop/asset-manifest.json"
      },
      {
        "from": "desktop-resources/icon.png",
        "to": "desktop/icon.png"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "DanielChydz",
        "repo": "paintdotjs",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": "pdn",
        "name": "Paint.NET image",
        "description": "Layered paint.js image",
        "mimeType": "application/x-paintdotnet",
        "role": "Editor",
        "rank": "Owner"
      },
      {
        "ext": "png",
        "name": "PNG image",
        "mimeType": "image/png",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "jpg",
        "name": "JPEG image",
        "mimeType": "image/jpeg",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "jpeg",
        "name": "JPEG image",
        "mimeType": "image/jpeg",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "webp",
        "name": "WebP image",
        "mimeType": "image/webp",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "gif",
        "name": "GIF image",
        "mimeType": "image/gif",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "bmp",
        "name": "Bitmap image",
        "mimeType": "image/bmp",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "tif",
        "name": "TIFF image",
        "mimeType": "image/tiff",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "tiff",
        "name": "TIFF image",
        "mimeType": "image/tiff",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "jxl",
        "name": "JPEG XL image",
        "mimeType": "image/jxl",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "avif",
        "name": "AVIF image",
        "mimeType": "image/avif",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "heic",
        "name": "HEIC image",
        "mimeType": "image/heic",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "heif",
        "name": "HEIF image",
        "mimeType": "image/heif",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "dds",
        "name": "DirectDraw surface",
        "mimeType": "image/vnd-ms.dds",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "tga",
        "name": "Targa image",
        "mimeType": "image/x-tga",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "jxr",
        "name": "JPEG XR image",
        "mimeType": "image/vnd.ms-photo",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "wdp",
        "name": "JPEG XR image",
        "mimeType": "image/vnd.ms-photo",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "wmp",
        "name": "JPEG XR image",
        "mimeType": "image/vnd.ms-photo",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "icon": "desktop-resources/icon.png",
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "packaging/entitlements.mac.plist",
      "entitlementsInherit": "packaging/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Take a photo and open it as an image in paint.js."
      },
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "sign": false
    },
    "deb": {
      "maintainer": "Daniel <dan.devmail@proton.me>",
      "packageCategory": "graphics",
      "depends": [
        "libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64",
        "libcups2t64"
      ],
      "recommends": [],
      "fpm": [
        "--deb-compression-level",
        "9"
      ]
    },
    "rpm": {
      "maintainer": "Daniel <dan.devmail@proton.me>",
      "packageCategory": "Applications/Graphics"
    },
    "linux": {
      "icon": "desktop-resources/icon.png",
      "category": "Graphics",
      "target": [
        "AppImage"
      ],
      "syncDesktopName": true,
      "synopsis": "An open source raster graphics editor",
      "description": "An open source general-purpose raster graphics editor with support for multiple documents, layers, and common image formats."
    },
    "win": {
      "icon": "desktop-resources/icon.png"
    }
  }
}
